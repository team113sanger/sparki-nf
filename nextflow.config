
/*
========================================================================================
  Nextflow config file
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Boilerplate options
    outdir                     = './results'
    tracedir                   = "${params.outdir}/pipeline_info"
    
    // Max requirements
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'
} 

profiles {

    farm22 {

        params {
            metadata = ""
            metadata_sample_column = ""
            metadata_columns = ""
            prefix = ""
            verbosity = "error"
            samples_to_remove = ""
            flags = ""
        }

        process.executor = 'lsf'

        docker {
            enabled = false
        }

        executor {
            name = 'lsf'
            perJobMemLimit = true
            queueSize = 20
            submitRateLimit = '5 sec'
            killBatchSize = 50
            poolSize = 4
        }

        process {
            withName: BAM_TO_FASTQ { 
                memory = 20.GB
                cpus = 8
                queue = 'normal'
            }
            withName: RUN_KRAKEN2 { 
                memory = 20.GB
                cpus = 8
                queue = 'normal'
            }
            withName: RUN_KRAKENTOOLS {
                memory = 8.GB
                cpus = 2
                queue = 'normal'
            }
            withName: RUN_SPARKI {
                memory = 12.GB
                cpus = 2
                queue = 'normal'
            }
        }
    }

}



