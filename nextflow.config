
/*
========================================================================================
  Nextflow config file
========================================================================================
  Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Boilerplate options
    outdir                     = './results'
    tracedir                   = "${params.outdir}/pipeline_info"
    metadata                   = ""
    metadata_sample_column     = ""
    metadata_columns           = ""
    prefix                     = ""
    verbosity                  = "error"
    samples_to_remove          = ""
    flags                      = ""
    
    // Max requirements
    max_memory                 = 128.GB
    max_cpus                   = 16
    max_time                   = 240.h
} 

profiles {

    container {
    
        docker {
            enabled = true
        }
    }

    farm22 {

        process.executor = 'lsf'

        docker {
            enabled = true
        }

        executor {
            name = 'lsf'
            perJobMemLimit = true
            queueSize = 20
            submitRateLimit = '5 sec'
            killBatchSize = 50
            poolSize = 4
        }

        process {
            withName: BAM_TO_FASTQ { 
                memory = 20.GB
                cpus = 8
                queue = 'normal'
            }
            withName: RUN_KRAKEN2 { 
                memory = 20.GB
                cpus = 8
                queue = 'normal'
            }
            withName: RUN_KRAKENTOOLS {
                memory = 8.GB
                cpus = 2
                queue = 'normal'
            }
            withName: RUN_SPARKI {
                memory = 12.GB
                cpus = 2
                queue = 'normal'
            }
        }
    }
}

manifest {
    name            = 'sparki-nf'
    author          = 'Jacqueline Boccacino, jb62@sanger.ac.uk'
    homePage        = 'https://gitlab.internal.sanger.ac.uk/team113_projects/jb62-projects/sparki-nf'
    description     = 'NextFlow pipeline for running SPARKI'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.04.5'
    version         = '1.0.0'
    defaultBranch   = 'develop'
}
