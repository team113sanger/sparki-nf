
/*
========================================================================================
  Nextflow config file
========================================================================================
  Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// One id names all of a run's artifacts - nextflow log (nextflow-run-<RUN_ID>.log),
// execution trace (execution_trace-<RUN_ID>.txt) and execution report
// (execution_report-<RUN_ID>.html) - so they can be matched up at a glance.
// The run wrapper computes and exports RUN_ID (label/study_project_cohort plus a
// YYYYMMDDTHHMMSS timestamp); direct `nextflow run` invocations fall back to a
// bare timestamp in the same format.
def run_id = System.getenv('RUN_ID') ?: new java.util.Date().format("yyyyMMdd'T'HHmmss")

// Where this run's execution trace and report go. The run wrapper exports TRACE_DIR;
// System.getenv (rather than a "${TRACE_DIR}" interpolation) is used deliberately - an
// unset variable in a Nextflow config string does not fail the parse, it silently
// becomes a placeholder, whereas getenv returns null and falls back cleanly here.
// Both artifacts are built from the same trace_dir, so the asset config needs no
// report {} override.
def trace_dir   = System.getenv('TRACE_DIR') ?: 'results/pipeline_info'
def trace_path  = "${trace_dir}/execution_trace-${run_id}.txt"
def report_path = "${trace_dir}/execution_report-${run_id}.html"

// Global default params, used in configs
params {

    // Boilerplate options
    outdir                     = './results'
    publish_dir_mode           = 'copy'

    // Required workflow inputs. Declared null here and validated in main.nf, so a
    // missing value is a named error rather than a null dereference deep in a channel.
    bam_files                  = null
    reference_database         = null
    confidence                 = null
    organism                   = null
    domain                     = null

    // Subcohort processing (accepts true/false/1/0). False - the default - runs
    // SPARKI once over every classified sample, published under
    // outdir/sparki/all_samples. True splits the SPARKI step into one run per
    // entry in `subcohorts` below, and is an error when that map is empty.
    // Toggling this off leaves a populated `subcohorts` map in place, ignored.
    use_subcohorts             = false

    // How a run whose inputs resolve to zero samples is treated (accepts
    // true/false/1/0). False - the default - is an error: an empty cohort is
    // almost always a mis-set BAMS_DIR or a sample-list path that moved. True
    // logs a warning and completes successfully, so a cohort that is wired up but
    // has no data yet records a 'completed' run rather than a 'failed' one. Empty
    // sample lists still classify every matched BAM and skip only the SPARKI step;
    // only a bam_files glob that matches nothing runs nothing at all. Set it per cohort in the asset config rather than globally,
    // so a typo in a cohort that does have data still fails loudly.
    allow_empty_input          = false

    // Subcohorts - map of subcohort name to config with a sample_list path. Only
    // read when use_subcohorts is true. Kraken2 classifies every sample matched
    // by bam_files; each subcohort then gets its own SPARKI run over just the
    // samples its list names, published under outdir/sparki/<subcohort>.
    // Example:
    // subcohorts = [
    //     "one_per_patient": [sample_list: "/path/to/one_per_patient.tsv"],
    //     "final_decision":  [sample_list: "/path/to/final_decision.tsv"],
    // ]
    subcohorts                 = [:]

    // Optional workflow inputs.
    metadata                   = ""
    metadata_sample_column     = ""
    metadata_columns           = ""
    prefix                     = ""
    verbosity                  = "error"
    samples_to_remove          = ""
    flags                      = ""

    // Max requirements
    max_memory                 = 128.GB
    max_cpus                   = 16
    max_time                   = 240.h

    // Skip status reporting for stub/test runs (accepts true/false/1/0).
    // `-stub-run` on the CLI (workflow.stubRun) is also honoured, so this flag
    // is only needed where that is unavailable.
    is_stub                    = false

    // Run reporting is deliberately kept out of the workflow's params: it is gated by
    // two env-var opt-ins exported by the run wrapper (see assets/run_pathogen_id.sh)
    // and lib/Utils.groovy reads everything it needs (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL, RUN_ID)
    // straight from the environment in the onComplete handler:
    //   DERMATLAS_WEBSITE_LOGGING     - record the run via `dermatlas-http cohort
    //                                   analysis-log` (>= 0.6.1).
    //   DERMATLAS_SLACK_NOTIFICATIONS - post a Slack message on completion.
    // The one reporting value that is a param is this pipeline's own slug in the
    // analysis log - pipeline-owned metadata, like the manifest version. It is the
    // website's analysis-log key and is deliberately spelled differently from the
    // launcher's dermanager slug (pathogen_id_pipe): two contracts, two systems.
    analysis_pipeline_slug     = "pathogen_pipe"

    // Path of this run's execution trace. Assigned from the same value as trace.file
    // below, so the two can never drift; read by the onComplete handler and attached to
    // the analysis-log record (--nextflow-performance) when website logging is opted in.
    trace_file                 = trace_path
}

profiles {

    container {
    
        docker {
            enabled = true
        }
    }

    farm22 {

        process.executor = 'lsf'

        singularity.runOptions = "--bind /lustre"

        // Site reference data only. Anything project-shaped (output locations, metadata
        // and sample-list paths) belongs in the run's own -c config, driven by the
        // project source_me.sh - see assets/pathogen_id.config.
        params {
            reference_database = "/lustre/scratch127/casm/projects/dermatlas/references/kraken2/PlusPFP_Capped16GB_March2023"
        }

        singularity {
            enabled    = true
            autoMounts = true
            // Must match the NXF_SINGULARITY_CACHEDIR pinned by assets/run_pathogen_id.sh:
            // an LSF job inherits the submitter's profile, and Nextflow's default cache
            // lives under work/, which the launcher's cleanup deletes.
            cacheDir   = '/lustre/scratch127/casm/projects/dermatlas/singularity_images'
            registry = 'gitlab-registry.internal.sanger.ac.uk'
        }


        docker {
            enabled = false
        }

        executor {
            name = 'lsf'
            perJobMemLimit = true
            queueSize = 20
            submitRateLimit = '5 sec'
            killBatchSize = 50
            poolSize = 4
        }

        process {
            withName: BAM_TO_FASTQ { 
                memory = 20.GB
                cpus = 8
                queue = 'normal'
            }
            withName: RUN_KRAKEN2 { 
                memory = 20.GB
                cpus = 8
                queue = 'normal'
            }
            withName: RUN_KRAKENTOOLS {
                memory = 8.GB
                cpus = 2
                queue = 'normal'
            }
            withName: RUN_SPARKI {
                memory = 12.GB
                cpus = 2
                queue = 'normal'
            }
        }
    }
}

report {
    enabled = true
    file    = report_path
}

trace {
    enabled   = true
    file      = trace_path
    overwrite = false
}

manifest {
    name            = 'sparki-nf'
    author          = 'Jacqueline Boccacino, jb62@sanger.ac.uk'
    homePage        = 'https://github.com/team113sanger/sparki-nf'
    description     = 'NextFlow pipeline for running SPARKI'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.00.0'
    version         = '1.0.1'
    defaultBranch   = 'main'
}
