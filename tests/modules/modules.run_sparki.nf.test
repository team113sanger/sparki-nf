nextflow_process {

    name "Test process RUN_SPARKI"
    script "modules/modules.nf"
    process "RUN_SPARKI"

    test("Should run without failures when only the required arguments are provided") {

        when {
            params {
                std_reports = "${baseDir}/tests/testdata/std_reports"
                mpa_reports = "${baseDir}/tests/testdata/mpa_reports"
                organism = "'Homo sapiens'"
                ref_dir = "${baseDir}/tests/testdata/kraken2_reference"
                domain = "Viruses"
            }
            process {
                """
                // Required arguments.
                input[0] = params.std_reports  // Standard reports directory (pipeline flow control).
                input[1] = params.mpa_reports  // MPA reports directory (pipeline flow control).
                input[2] = params.std_reports  // Standard reports directory (actual SPARKI input).
                input[3] = params.mpa_reports  // MPA reports directory (actual SPARKI input).
                input[4] = params.organism     // Organism being analysed.
                input[5] = params.ref_dir      // Kraken2 reference database where 'inspect.txt' can be found.
                input[6] = params.domain       // Domain of interest.
                input[7] = "${outputDir}"      // Output directory.

                // Optional arguments that should be picked up from nextflow.config.
                input[8] = params.metadata                  // Metadata table.
                input[9] = params.metadata_sample_column    // Sample column in metadata table.
                input[10] = params.metadata_columns         // Other columns in metadata table.
                input[11] = params.prefix                   // Prefix for output files.
                input[12] = params.verbosity                // Verbosity level.
                input[13] = params.samples_to_remove        // List of samples to be removed.
                input[14] = params.flags                    // Additional flags.
                """
            }
        }

        then {
            // Check the process runs successfully.
            assert process.success
            assert process.exitStatus == 0

            // Check the process generates the expected number of tasks.
            assert process.trace.tasks().size() == 1
        }
    }

    test("Should run without failures when both the required and optional arguments are provided") {

        when {
            params {
                std_reports = "${baseDir}/tests/testdata/std_reports"
                mpa_reports = "${baseDir}/tests/testdata/mpa_reports"
                organism = "'Homo sapiens'"
                ref_dir = "${baseDir}/tests/testdata/kraken2_reference"
                domain = "Viruses"
                metadata = "${baseDir}/tests/testdata/metadata.csv"
                metadata_sample_column = "sample"
                metadata_columns = "date,country"
                prefix = "test"
                verbosity = "info"
                samples_to_remove = "${baseDir}/tests/testdata/samples_to_remove.txt"
                flags = ""

            }
            process {
                """
                // Required arguments.
                input[0] = params.std_reports  // Standard reports directory (pipeline flow control).
                input[1] = params.mpa_reports  // MPA reports directory (pipeline flow control).
                input[2] = params.std_reports  // Standard reports directory (actual SPARKI input).
                input[3] = params.mpa_reports  // MPA reports directory (actual SPARKI input).
                input[4] = params.organism     // Organism being analysed.
                input[5] = params.ref_dir      // Kraken2 reference database where 'inspect.txt' can be found.
                input[6] = params.domain       // Domain of interest.
                input[7] = "${outputDir}"      // Output directory.
                
                // Optional arguments.
                input[8] = params.metadata                  // Metadata table.
                input[9] = params.metadata_sample_column    // Sample column in metadata table.
                input[10] = params.metadata_columns         // Other columns in metadata table.
                input[11] = params.prefix                   // Prefix for output files.
                input[12] = params.verbosity                // Verbosity level.
                input[13] = params.samples_to_remove        // List of samples to be removed.
                input[14] = params.flags                    // Additional flags.
                """
            }
        }

        then {
            // Check the process runs successfully.
            assert process.success
            assert process.exitStatus == 0

            // Check the process generates the expected number of tasks.
            assert process.trace.tasks().size() == 1
        }
    }
}
