nextflow_process {

    name "Test process RUN_KRAKENTOOLS"
    script "modules/modules.nf"
    process "RUN_KRAKENTOOLS"

    test("Should run without failures") {

        when {
            params {
                std_reports = "${baseDir}/tests/testdata/std_reports/**.kraken"
            }
            process {
                """
                input[0] = Channel.fromPath(params.std_reports, checkIfExists: true)
                    .map { file -> tuple(file.simpleName, file) }
                """
            }
        }

        then {
            // Check the process runs successfully.
            assert process.success

            // Check the process generates the expected number of tasks.
            //
            // For 1 input standard report file, this number should be 1.
            //
            assert process.trace.tasks().size() == 1

            // Check the output of the process contains the expected number
            // of tuples.
            //
            // For 1 input standard report file, this number should be 1.
            //
            assert process.out.mpa_report.size() == 1

            // Take snapshot and check if it matches the previous one.
            assert snapshot(process.out).match()

            // Inspect the output channel...
            with(process.out.mpa_report) {

                // Inspect one of the tuples emitted by the channel...
                with(get(0)) {

                    // Check the tuple contains the expected values.
                    assert get(0) ==~ "sample.*"
                    assert get(1) ==~ ".*kraken.mpa"
                }
            }
        }

    }

}
