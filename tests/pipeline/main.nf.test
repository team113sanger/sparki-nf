nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("The pipeline runs successfully when no optional inputs for SPARKI are provided") {

        when {
            params {
                bam_files = "$baseDir/tests/testdata/bam_files/**.bam"
                reference_database = "$baseDir/tests/testdata/kraken2_ref_db"
                confidence = "0.1"
                organism = "'Homo sapiens'"
                domain = "Viruses"
            }
        }

        then {
            // Check the pipeline runs successfully.
            assert workflow.success
            assert workflow.exitStatus == 0

            // Check the pipeline creates the correct number of tasks.
            //
            // For 3 input BAM files, the total number of tasks that should have
            // been created by the time the pipeline finishes running is 10.
            //
            // Breakdown:
            // - 3 BAM to FASTQ tasks;
            // - 3 Kraken2 tasks;
            // - 3 KrakenTools tasks;
            // - 1 SPARKI task.
            //
            assert workflow.trace.tasks().size() == 10

            // Inspect outputs...
            with(BAM_TO_FASTQ.out) {

                // Check the pipeline creates the correct number of output files.
                //
                // For 3 input BAM files, the total number of output files that should have
                // been created by the time the pipeline finishes running is 20.
                // 
                // Breakdown:
                // - 3 FASTQ files;
                // - 3 standard reports generated by Kraken2;
                // - 3 MPA-style reports generated by KrakenTools;
                // - 11 output files generated by SPARKI.
                //
                assert path(index.get(0)).list().size() == 20
            }
        }

    }

}
