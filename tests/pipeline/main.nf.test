nextflow_pipeline {

    name "Test workflow main.nf"
    script "main.nf"

    test("The pipeline runs successfully when no optional inputs for SPARKI are provided") {

        when {
            params {
                bam_files = "${baseDir}/tests/testdata/bam_files/**.bam"
                reference_database = "${baseDir}/tests/testdata/kraken2_reference"
                confidence = "0.1"
                organism = "'Homo sapiens'" // Using 'Homo sapiens' only for testng purposes, as 'Felis catus' is not present.
                domain = "Viruses"
            }
        }

        then {
            // Check the pipeline runs successfully.
            assert workflow.success
            assert workflow.exitStatus == 0

            // Check the pipeline creates the correct number of tasks.
            //
            // For 3 input CRAM files, the total number of tasks that should have
            // been created by the time the pipeline finishes running is 10.
            //
            // Breakdown:
            // - 3 CRAM to FASTQ tasks;
            // - 3 Kraken2 tasks;
            // - 3 KrakenTools tasks;
            // - 1 SPARKI task.
            //
            assert workflow.trace.tasks().size() == 10
        }
    }

    test("The pipeline runs successfully when all optional inputs for SPARKI are provided") {

        when {
            params {
                bam_files = "${baseDir}/tests/testdata/bam_files/**.bam"
                reference_database = "${baseDir}/tests/testdata/kraken2_reference"
                confidence = "0.1"
                organism = "'Homo sapiens'" // Using 'Homo sapiens' only for testng purposes, as 'Felis catus' is not present.
                domain = "Viruses"
                metadata = "${baseDir}/tests/testdata/metadata_table.csv"
                metadata_sample_column = "sample"
                metadata_columns = "mock_column1,mock_column2"
                prefix = "ERP143204_feline_basal_cell_carcinoma"
                verbosity = "info"
                samples_to_remove = "${baseDir}/tests/testdata/samples_to_remove.txt"
                flags = ""
            }
        }

        then {
            // Check the pipeline runs successfully.
            assert workflow.success
            assert workflow.exitStatus == 0

            // Check the pipeline creates the correct number of tasks.
            //
            // For 3 input BAM files, the total number of tasks that should have
            // been created by the time the pipeline finishes running is 10.
            //
            // Breakdown:
            // - 3 BAM to FASTQ tasks;
            // - 3 Kraken2 tasks;
            // - 3 KrakenTools tasks;
            // - 1 SPARKI task.
            //
            assert workflow.trace.tasks().size() == 10
        }
    }
}
