params {
    // Every projectify location below comes from the project source_me.sh.
    // run_pathogen_id.sh checks these are exported before nextflow is launched -
    // an unset variable is not an error to the config parser, it silently becomes
    // a placeholder string, so the guard in the wrapper is what catches it.
    bam_files = "${BAMS_DIR}/**.bam"
    outdir    = "${ANALYSIS_DIR}/pathogen_id"

    // Cohort-independent, pipeline-owned: not a source_me.sh concern. The farm22
    // profile also sets this; repeated here so a git-clone run on another profile
    // still resolves it.
    reference_database = "/lustre/scratch127/casm/projects/dermatlas/references/kraken2/PlusPFP_Capped16GB_March2023"

    // Science inputs, stated explicitly rather than inherited from a default.
    confidence = "0.1"
    organism   = "'Homo sapiens'"
    domain     = "Viruses"
    verbosity  = "debug"

    // Subcohorts. Kraken2 runs over every BAM matched by bam_files above; each
    // subcohort below gets its own SPARKI run restricted to the samples its list
    // names, published under outdir/sparki/<subcohort>. The sample lists are
    // generated and versioned by dermanager, so they are referenced by the
    // variable names it exports rather than rebuilt from a filename convention.
    //
    // The split is what use_subcohorts switches on: set it to false (or pass
    // `--use_subcohorts false`) for a single SPARKI analysis over every sample,
    // published under outdir/sparki/all_samples, without editing the map below.
    use_subcohorts = true
    subcohorts = [
        "one_per_patient": [
            sample_list: "${RNA_SAMPLE_LIST_ONE_PER_PATIENT}"
        ],
        "final_decision": [
            sample_list: "${RNA_SAMPLE_LIST_FINAL_DECISION}"
        ]
    ]

    // Whether a run that resolves to zero samples is an error (false, the default)
    // or a warning and a successful no-op (true). Left at the default here: for a
    // cohort with data, an empty BAMS_DIR or an empty dermanager sample list means
    // something upstream is wrong, and should fail rather than record a green run
    // that analysed nothing. Set it to true only for a cohort that is deliberately
    // wired up ahead of its data, so its scheduled runs log 'completed'.
    allow_empty_input = false

    // Optional workflow inputs. These are not part of the environment contract -
    // dermanager exports no variable for either - so they use System.getenv rather
    // than shell-style interpolation: unset must mean unset, not a placeholder string.
    // Unset is the empty string, matching the nextflow.config defaults: a val() process
    // input rejects null, and RUN_SPARKI drops the corresponding flag when it is falsy.
    metadata               = System.getenv('SPARKI_METADATA') ?: ""
    metadata_sample_column = System.getenv('SPARKI_METADATA_SAMPLE_COLUMN') ?: ""
    metadata_columns       = System.getenv('SPARKI_METADATA_COLUMNS') ?: ""
    samples_to_remove      = System.getenv('SPARKI_SAMPLES_TO_REMOVE') ?: ""

    // Run reporting needs no params here: it is gated by the DERMATLAS_WEBSITE_LOGGING /
    // DERMATLAS_SLACK_NOTIFICATIONS env vars exported by run_pathogen_id.sh, and the
    // pipeline's onComplete handler reads the payload values (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL) straight from
    // the environment.
}
